# Docker Compose 默认读取同目录下的 .env。复制后填写，勿提交真实凭据。
MEMDOCK_MODE=private
# 首次启动前设置至少 6 个字符的 Private Console 管理员密码。
MEMDOCK_ADMIN_PASSWORD=
MEMDOCK_PORT=8080
# Private API/MCP 写入密钥；Secure 模式同一密钥认证所有请求。至少 32 字节。
# 例如：openssl rand -hex 32
MEMDOCK_WRITE_SECRET=

# Secure 模式必须设置 TLS（直连证书或可信代理 TLS 边界）。
MEMDOCK_TLS_DIR=./certs
MEMDOCK_TLS_CERT=
MEMDOCK_TLS_KEY=
MEMDOCK_TRUST_PROXY_TLS=false
MEMDOCK_TRUST_PROXY_CIDRS=
