# Docker Compose 默认读取同目录下的 .env。复制后填写，勿提交真实凭据。
MEMDOCK_MODE=private
MEMDOCK_PORT=8080
# Private 写入使用，至少 32 字节；例如用 openssl rand -hex 32 生成。
MEMDOCK_APPROVAL_KEY=

# Secure 模式需要不同的读写 token、公钥、ACL 和 TLS 配置。
MEMDOCK_READ_TOKEN=
MEMDOCK_WRITE_TOKEN=
MEMDOCK_APPROVAL_PUBLIC_KEY=
MEMDOCK_CONFIG_DIR=./config
MEMDOCK_TLS_DIR=./certs
MEMDOCK_TLS_CERT=
MEMDOCK_TLS_KEY=
MEMDOCK_TRUST_PROXY_TLS=false
MEMDOCK_TRUST_PROXY_CIDRS=
